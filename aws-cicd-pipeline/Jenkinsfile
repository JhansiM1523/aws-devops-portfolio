pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps { echo 'Code checkout done' }
    }
    stage('Build') {
      steps { echo 'Building app...' }
    }
    stage('Test') {
      steps { echo 'Running tests...' }
    }
    stage('Deploy to AWS') {
      steps { echo 'Deploying to EC2...' }
    }
  }
}
